# MongoDB Connection String (Local or MongoDB Atlas)
# For local MongoDB: mongodb://localhost:27017/bmi_plus_db
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/bmi_plus_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bmi_plus_db

# Server Port
PORT=5000

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=bmi_plus_super_secret_jwt_key_2026_academic_project

# Environment Mode (development or production)
NODE_ENV=development

